# --- Option A: single instance ---------------------------------------------
HA_URL=http://homeassistant.local:8123
HA_TOKEN=your_long_lived_access_token

# --- Option B: multiple instances (takes precedence over HA_URL/HA_TOKEN) ---
# JSON map of instance name -> { url, token, aliases? }
# HA_INSTANCES_JSON={"home":{"url":"http://homeassistant.local:8123","token":"..."},"office":{"url":"https://ha.example.com","token":"...","aliases":["work"]}}
# Instance used when a tool call doesn't specify one (defaults to the first key)
# HA_DEFAULT_INSTANCE=home
# Restrict this server process to a single instance (same as --instance=<name>)
# HA_LOCKED_INSTANCE=home

# --- Optional: history timestamps --------------------------------------------
# HA_LOCALE=en-US
# HA_TIMEZONE=America/New_York

# --- Optional: camera watches -------------------------------------------------
# Where ha_watch_camera writes watches (default: ./data/camera_watches.json; "~" is expanded)
# HA_CAMERA_WATCHES_PATH=~/.config/mcp-home-assistant/camera_watches.json
# NVR channel number -> friendly name
# HA_CAMERA_CHANNELS_JSON={"1":"Front Door","2":"Backyard","3":"Garage"}
# Instance whose motion binary_sensors are listed by ha_get_camera_watches
# HA_CAMERA_INSTANCE=home
